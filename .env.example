# ============================================================
# CampaignAgent - Root Environment
# ============================================================

APP_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
BACKEND_URL=http://localhost:8000

# PostgreSQL / Supabase
DATABASE_URL=postgresql+asyncpg://campaignagent:campaignagent@localhost:5432/campaignagent

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO